;++

;
; AMD BC-250 WDDM Graphics Driver INF
;
; This is a full WDDM adapter driver with KMD + UMD components.
; The KMD (amdbc250kmd.sys) handles GPU initialization and command submission.
; The UMD (amdbc250umd64.dll) provides the user-mode D3D runtime interface.
;
;--

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%ProviderString%
DriverVer=09/21/2026, 2.0.0.0
CatalogFile=amdbc250.cat
PnpLockdown=1

[DestinationDirs]
amdbc250_Files_KM = 12
DefaultDestDir = 11

[SourceDisksNames]
1=%DiskDescription%,,,.

[SourceDisksFiles]
amdbc250kmd.sys = 1
amdbc250umd64.dll = 1

[Manufacturer]
%ManufacturerName%=AMD,NTamd64

[AMD.NTamd64]
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_13FE1002&REV_C4
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FE&SUBSYS_00001022
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FE
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13DB
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13F9
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FA
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FB
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_13FC
%BC250DeviceName% = amdbc250_Inst, PCI\VEN_1002&DEV_143F

[amdbc250_Inst]
FeatureScore=F0
CopyFiles = amdbc250_Files_KM, amdbc250_Files_UM

;
;   Install driver service
;
[amdbc250_Inst.Services]
AddService = amdbc250kmd,0x00000002,amdbc250_Service_Inst

[amdbc250_Service_Inst]
ServiceType = 0x1
StartType = 0x3
ErrorControl = 0x0
ServiceBinary = %12%\amdbc250kmd.sys

;
;   User-mode component registration
;
[amdbc250_Inst.SoftwareSettings]
AddReg = amdbc250_UMD_Reg

[amdbc250_UMD_Reg]
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000",InstalledDisplayDrivers,,"amdbc250umd64"
HKLM,"SYSTEM\CurrentControlSet\Control\Class\{4d36e968-e325-11ce-bfc1-08002be10318}\0000",UserModeDriverName,,"%11%\amdbc250umd64.dll"

[amdbc250_Files_KM]
amdbc250kmd.sys

[amdbc250_Files_UM]
amdbc250umd64.dll

[Strings]
ProviderString="AMD BC-250 Driver Project"
ManufacturerName="Advanced Micro Devices, Inc."
DiskDescription="AMD BC-250 Driver Installation Disk"
BC250DeviceName="AMD BC-250 Graphics Adapter"